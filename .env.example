# ChatDev Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Optional: OpenAI Organization ID
# OPENAI_ORG_ID=org-your-org-id

# Model Configuration
# Choose from: GPT_3_5_TURBO, GPT_4, GPT_4_32K
DEFAULT_MODEL=GPT_3_5_TURBO

# Application Settings
LOG_LEVEL=INFO
DEBUG=False

# Directory Configuration
WAREHOUSE_DIR=WareHouse
CONFIG_DIR=CompanyConfig

# Git Management
# Enable git version control for generated projects
GIT_MANAGEMENT=False

# GUI Design
# Enable GUI design phase
GUI_DESIGN=False

# Self Improvement
# Enable AI-powered prompt improvement
SELF_IMPROVE=False

# Clear Structure
# Remove temporary files after execution
CLEAR_STRUCTURE=True

# Incremental Development
# Build upon existing codebase
INCREMENTAL_DEVELOP=False

# API Rate Limiting
MAX_RETRIES=3
TIMEOUT_SECONDS=300

# Development Settings (only for dev environment)
# DEV_MODE=True
# TEST_MODE=False
